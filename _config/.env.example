# === COMPUTADORA - Variables de Entorno ===
# Copia este archivo como .env y llena los valores

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# GitHub Copilot Token — Automatic OAuth (NO LLENAR A MANO)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# COPILOT_TOKEN: Obtenido automáticamente en primera ejecución
#
# 🔐 CÓMO FUNCIONA:
#   ① Primera vez que Computadora necesita Copilot (Nivel 3 — razonamiento avanzado)
#   ② Se abre navegador → GitHub solicita autorización
#   ③ Tú haces clic "Autorizar" → GitHub genera token
#   ④ Computadora lo captura AUTOMÁTICAMENTE y guarda en datos/copilot_auth.json
#   ⑤ Token se refresca automáticamente antes de expirar
#   ⑥ Tú NO haces nada — todo es transparente
#
# 📝 DETALLES:
#   - NO es lo mismo que COPILOT_TOKEN en VS Code
#   - Este es GitHub Copilot Chat API directo (sin VS Code)
#   - Usa OAuth Device Flow (seguro, sin credenciales compartidas)
#   - Cifrado localmente en datos/copilot_auth.json
#   - NUNCA se transmite sin encriptación
#
# 🚫 ADVERTENCIA: Nunca copiar/pegar token manual aquí
#    El token debe ser obtenido SOLO por OAuth Device Flow
#
COPILOT_TOKEN=

# Ollama (fallback LLM local)
OLLAMA_URL=http://localhost:11434

# Whisper
WHISPER_MODELO=base

# Logging
LOG_LEVEL=DEBUG
